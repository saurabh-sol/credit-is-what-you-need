# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Free from https://cloud.reown.com. With it, the wallet list offers MetaMask,
# Rainbow, Coinbase, WalletConnect, Rabby, Trust, OKX and Ledger, including phone
# wallets by QR code. Without it, only browser wallets and Coinbase are offered.
# It is read when the site is built, so rebuild after changing it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: private RPC URLs (e.g. Alchemy). These are used in the browser, so
# restrict the key to your domain in the Alchemy dashboard. With an Alchemy URL
# the record scanner reads wallet history straight from the chain (Alchemy's
# transaction index), which is how mainnet works: its public explorer blocks
# server requests.
NEXT_PUBLIC_RPC_MAINNET=
# Server-only alternatives, if you'd rather not ship the key to browsers.
RPC_MAINNET=

# Optional: where the record scanner reads wallet history when the network has
# no Alchemy RPC (Blockscout API v2). For mainnet without Alchemy, set a
# Blockscout API key or point EXPLORER_API_MAINNET at your own indexer.
EXPLORER_API_MAINNET=
BLOCKSCOUT_API_KEY=

# Where credits are stored (SQLite file). Defaults to data/kredit.db.
DATABASE_PATH=

# Neon Postgres connection string (Neon console → Connect → pooled URL). Read
# only on the server (src/lib/neon.ts); never expose it to client-side code.
DATABASE_URL=

# The AI provider behind /v1. Vercel AI Gateway is the default: one key reaches
# every maker, and its public model list carries the prices calls are billed
# from. OpenRouter works too. Without a key, only the test model "kredit/echo" works.
UPSTREAM_BASE_URL=https://ai-gateway.vercel.sh/v1
UPSTREAM_API_KEY=

# Optional: on-chain receipts. With the KreditReceipts contract deployed
# (contracts/README.md) and the key it trusts, claims are signed by the
# server and submitted by the wallet, so every claim is a transaction on
# Blockscout. Leave the address empty to keep claims off-chain. The signer key is a plain private key (openssl rand -hex 32
# with 0x in front); its address goes into the contract's `signer`.
RECEIPTS_ADDRESS_MAINNET=
RECEIPT_SIGNER_KEY=

# Optional: let people buy credits with your own ERC-20 token. They send tokens
# to the treasury and the server credits what the transaction receipt proves.
# Buying stays switched off until the token, the treasury and a price are set.
TOPUP_TOKEN_ADDRESS=
TOPUP_TOKEN_SYMBOL=
TOPUP_TOKEN_DECIMALS=18
TOPUP_TREASURY_ADDRESS=
TOPUP_CREDITS_PER_TOKEN=         # e.g. 100 means 1 token buys 100 credits ($0.10 of AI usage)
