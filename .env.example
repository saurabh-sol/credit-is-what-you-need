# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Free from https://cloud.reown.com. With it, the wallet list offers MetaMask,
# Rainbow, Coinbase, WalletConnect, Rabby, Trust, OKX and Ledger, including phone
# wallets by QR code. Without it, only browser wallets and Coinbase are offered.
# It is read when the site is built, so rebuild after changing it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: private RPC URLs (e.g. Alchemy). These are used in the browser, so
# restrict the key to your domain in the Alchemy dashboard.
NEXT_PUBLIC_RPC_TESTNET=
NEXT_PUBLIC_RPC_MAINNET=

# Optional: where the record scanner reads wallet history (Blockscout API v2).
# The public mainnet explorer blocks server requests, so set a Blockscout API
# key or point EXPLORER_API_MAINNET at your own indexer to scan mainnet.
EXPLORER_API_TESTNET=
EXPLORER_API_MAINNET=
BLOCKSCOUT_API_KEY=

# Where credits are stored (SQLite file). Defaults to data/fuel.db (the name predates the rename to Kredit).
DATABASE_PATH=

# The AI provider behind /v1/chat/completions. Any OpenAI-compatible API works;
# OpenRouter is the default because it reports the exact cost of each call.
# Without a key, only the built-in test model "kredit/echo" works.
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
UPSTREAM_API_KEY=

# Optional: where Gas-Back reads the ETH/USD price (a Chainlink feed). Defaults
# to the feed on Ethereum mainnet through a public RPC; an Alchemy Ethereum URL
# here makes it more reliable.
PRICE_FEED_RPC_URL=
PRICE_FEED_ADDRESS=

# Optional: let people buy credits with your own ERC-20 token. They send tokens
# to the treasury and the server credits what the transaction receipt proves.
# Buying stays switched off until the token, the treasury and a price are set.
TOPUP_NETWORK=mainnet            # mainnet | testnet (Robinhood Chain)
TOPUP_TOKEN_ADDRESS=
TOPUP_TOKEN_SYMBOL=
TOPUP_TOKEN_DECIMALS=18
TOPUP_TREASURY_ADDRESS=
TOPUP_CREDITS_PER_TOKEN=         # e.g. 100 means 1 token buys 100 credits ($0.10 of AI usage)
