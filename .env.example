# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# The public address shown in docs, snippets and invite links (build-time).
# Defaults to https://usekredit.space.
NEXT_PUBLIC_SITE_URL=

# Sign-in is Privy (https://dashboard.privy.io): email code, Google, or a
# wallet. Enable those three login methods and "create an embedded wallet for
# users without one". The app id is public and read when the site is built, so
# rebuild after changing it; the secret stays on the server and verifies logins.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Optional: a private RPC URL (Alchemy). Server-only: with an Alchemy URL the
# record scanner reads wallet history from Alchemy's transaction index, which
# is how mainnet works (its public explorer blocks server requests). Everything
# else, and the browser, uses the chain's public RPC, and falls back to it when
# this one is down or over its monthly quota. NEXT_PUBLIC_RPC_MAINNET is still
# read for older deployments but is no longer sent to browsers.
RPC_MAINNET=

# Optional: where the record scanner reads wallet history when the network has
# no Alchemy RPC (Blockscout API v2). For mainnet without Alchemy, set a
# Blockscout API key or point EXPLORER_API_MAINNET at your own indexer.
EXPLORER_API_MAINNET=
BLOCKSCOUT_API_KEY=

# Where everything is stored: credits, keys, sessions, names. A Neon Postgres
# connection string (Neon console → Connect → pooled URL). The tables are
# created on first use. Read only on the server (src/lib/db.ts); never expose
# it to client-side code.
DATABASE_URL=

# The AI provider behind /v1. Vercel AI Gateway is the default: one key reaches
# every maker, and its public model list carries the prices calls are billed
# from. OpenRouter works too. Without a key, only the test model "kredit/echo" works.
UPSTREAM_BASE_URL=https://ai-gateway.vercel.sh/v1
UPSTREAM_API_KEY=

# Optional: a second provider. With an OpenRouter key, its models are offered
# next to the ones above (a model on both is served by the one above).
OPENROUTER_API_KEY=

# Optional: on-chain receipts. With the KreditReceipts contract deployed
# (contracts/README.md) and the key it trusts, claims are signed by the
# server and submitted by the wallet, so every claim is a transaction on
# Blockscout. Leave the address empty to keep claims off-chain. The signer key is a plain private key (openssl rand -hex 32
# with 0x in front); its address goes into the contract's `signer`.
RECEIPTS_ADDRESS_MAINNET=
RECEIPT_SIGNER_KEY=

# Optional: let people buy credits at a fixed dollar price, paid in USDG or in
# ETH, through the KreditCheckout contract (contracts/README.md). USDG goes
# from the buyer to the treasury; ETH is swapped for USDG on Uniswap v3 with the
# treasury as the recipient. The server credits what the receipt proves. Buying
# stays switched off until the contract and the treasury are set.
TOPUP_CHECKOUT_ADDRESS=
TOPUP_TREASURY_ADDRESS=
TOPUP_USDG_PER_CREDIT=800        # USDG base units (6 decimals) per credit: 800 = $0.0008, so 1,000 credits cost $0.80
TOPUP_POOL_FEE=100               # the WETH/USDG pool's fee tier (100 = 0.01%)
TOPUP_MAX_CREDITS_PER_BUY=100000
# TOPUP_USDG_ADDRESS=            # only to override the USDG address baked into src/lib/topup.ts
